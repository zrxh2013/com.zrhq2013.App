# ============================================================
# 信托公证提存服务 · 环境变量模板
# 用法：cp .env.example .env，填入真实值后执行 npm start
# 注意：.env 已被 .gitignore 忽略，权限应为 600，禁止提交或外发
# ============================================================

# 提存网络：mainnet（主网）| nile（测试网）
TRON_NETWORK=mainnet

# 签名私钥（64 位十六进制，可带 0x 前缀）
# 生成新密钥：node -e "const {TronWeb}=require('tronweb');TronWeb.createRandom().then(a=>console.log(a.privateKey))"
# 安全约定：私钥仅通过本环境变量注入，服务端不记录、不下发，前端永不接触
TRON_PRIVATE_KEY=

# Nile 测试网 USDT 合约（主网默认使用官方 USDT 合约，无需填写）
USDT_CONTRACT_NILE=

# 服务端口（默认 8899）
PORT=8899
