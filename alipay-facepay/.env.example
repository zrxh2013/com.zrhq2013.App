# ===== 运行模式 =====
# demo       本地演示，无需任何密钥，下单 8 秒后自动模拟支付成功
# sandbox    支付宝沙箱环境（开放平台 → 研发服务 → 沙箱）
# production 正式生产环境
ALIPAY_MODE=demo

# ===== 沙箱 / 正式环境必填（demo 模式留空即可）=====
# 开放平台应用 APPID
ALIPAY_APPID=
# 应用私钥（RSA2，支持单行 base64 或完整 PEM；请勿提交到代码仓库）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（RSA2，用于异步通知验签）
ALIPAY_PUBLIC_KEY=

# ===== 异步通知地址 =====
# 必须是支付宝服务器可公网访问的 HTTPS 地址；本地调试可用 cpolar/ngrok 内网穿透
# 示例：https://your-domain.example.com/api/notify
ALIPAY_NOTIFY_URL=

# ===== 服务端口 / 数据库 =====
PORT=8000
FACEPAY_DB=./facepay.db
