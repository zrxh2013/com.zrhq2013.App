# ============================================================
# 监听钱包环境变量配置模板
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# 注意：.env 已加入 .gitignore，不会被提交到版本库
# ============================================================

# ---------- 监听地址（必填） ----------
# TRON 监听地址（Base58 格式）
LISTEN_ADDRESS=TXKRaDanNVNhXKNWTHZ24vED3wuP2J7N4t

# BSC 监听地址（0x 格式，仅用于 listen-bsc 进程）
LISTEN_BSC_ADDRESS=0x0000000000000000000000000000000000000000

# ---------- 通知与阈值 ----------
# 通知金额阈值：仅当金额 >= 此值时才触发通知/webhook（DB 仍全量记录）
MIN_AMOUNT=0

# ---------- 数据库 ----------
# SQLite 数据库文件路径
DB_PATH=./data/transactions.db

# 自动导出 CSV 间隔（小时），0 = 关闭
AUTO_EXPORT_HOURS=24

# ---------- Telegram 推送（可选，需同时设置两项才生效） ----------
# BotFather 创建 Bot 后获得的 Token
TELEGRAM_BOT_TOKEN=
# 接收消息的 Chat ID（个人为正数，群组为负数）
TELEGRAM_CHAT_ID=

# ---------- API Key（可选，提高限流额度） ----------
# TronScan API Key
TRONSCAN_API_KEY=
# TronGrid API Key（启用事件 WebSocket 时需要）
TRONGRID_API_KEY=

# ---------- Webhook 回调（可选） ----------
# 收到交易时 POST 回调的 URL
WEBHOOK_URL=

# ---------- 网络代理（可选，沙箱/内网环境需要） ----------
# HTTPS 代理地址
HTTPS_PROXY=
# HTTP 代理地址
HTTP_PROXY=
